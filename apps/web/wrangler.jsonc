{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sufra",
  "main": "./src/server.ts",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // One D1 database serves Better Auth's own tables (generated by the BA CLI) AND the Effect
  // SQL domain layer. Both are migrated with `wrangler d1 migrations apply DB`. Migrations now
  // live in a top-level `migrations/` dir (the worker moved under `src/`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sufra",
      "database_id": "0668c68e-0485-465e-9dfa-7d775d51ca19",
      "migrations_dir": "./migrations",
    },
  ],
  // Sessions live in KV (strong-ish consistency) to avoid D1 read-after-write staleness right
  // after login. App data never goes in KV; auth sessions never go in D1 (ADR 0010).
  // NOTE: create the namespace with `wrangler kv namespace create SUFRA_KV` and paste the real
  // id here (and a staging one below) before the first remote deploy. Local `vite` dev simulates
  // KV regardless of this id.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2cbcacbd26674ff09086145d8d814921",
    },
  ],
  // R2 bucket for meal photos (and any future media). The `attachments` row holds the
  // server-minted object key; the Blobs service (src/worker/blobs/) puts/gets/deletes the bytes.
  // Sufra serves bytes through the authenticated Worker proxy (GET /api/meals/:id/photo) — no
  // public bucket, no presigned URLs (ADR 0014).
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sufra-photos",
    },
  ],
  // Brute-force throttle on `/api/auth/sign-in/*` — five attempts per IP per minute.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "5001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Staging — a SEPARATE Worker (`sufra-staging`) with its own D1, R2, KV. Secrets set
  // separately via `wrangler secret put ... --env staging`.
  "env": {
    "staging": {
      "name": "sufra-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sufra-staging",
          "database_id": "651361e9-b025-4c46-a83b-3ec4763eddfa",
          "migrations_dir": "./migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "bb42473904394fb6b45bfb56a69ac981",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "sufra-photos-staging",
        },
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "5002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
}
