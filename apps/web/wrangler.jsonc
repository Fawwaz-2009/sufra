{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sufra",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sufra",
      "database_id": "0668c68e-0485-465e-9dfa-7d775d51ca19",
      "migrations_dir": "./worker/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sufra-photos",
    },
  ],
  // Brute-force throttle on `/api/auth/sign-in/*` — five attempts per IP per
  // minute. Edge-native, free, zero provisioning; `namespace_id` is just an
  // account-unique integer (no Cloudflare resource to create). Counter is
  // tracked per Cloudflare colo, which is fine here — scrypt-hashed passwords
  // make even unthrottled brute-force impractical; this just kills credential
  // stuffing dead.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "5001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Staging environment — deploys a SEPARATE Worker (`sufra-staging`) with its
  // own D1 and R2. Secrets must be set separately via `wrangler secret put ...
  // --env staging`. Promote validated builds to prod via `wrangler deploy`
  // (no --env). See PRD §… (Operations / deploys).
  "env": {
    "staging": {
      "name": "sufra-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sufra-staging",
          "database_id": "651361e9-b025-4c46-a83b-3ec4763eddfa",
          "migrations_dir": "./worker/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "sufra-photos-staging",
        },
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "5002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
}
