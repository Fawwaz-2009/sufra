{
  "name": "@sufra/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --config ./auth.cli.ts --output ./migrations/0001_better_auth.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:request": "vitest run --project request"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.12",
    "@effect/sql-d1": "4.0.0-beta.74",
    "@openrouter/ai-sdk-provider": "^2",
    "ai": "^6",
    "better-auth": "1.6.12",
    "effect": "4.0.0-beta.74",
    "kysely": "0.28.17",
    "kysely-d1": "0.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/vitest-pool-workers": "0.16.10",
    "@effect/vitest": "4.0.0-beta.74",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.12.0",
    "better-sqlite3": "12.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.7",
    "wrangler": "^4.92.0"
  }
}