{
  "name": "@sufra/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.json",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --config ./auth.cli.ts --output ./migrations/0001_better_auth.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:request": "vitest run --project request"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@effect/sql-d1": "4.0.0-beta.74",
    "@fontsource-variable/raleway": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@openrouter/ai-sdk-provider": "^2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@tanstack/react-router": "^1.170.4",
    "ai": "^6",
    "better-auth": "1.6.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.74",
    "kysely": "0.28.17",
    "kysely-d1": "0.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.76.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/vitest-pool-workers": "0.16.10",
    "@effect/vitest": "4.0.0-beta.74",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "12.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.92.0"
  }
}
