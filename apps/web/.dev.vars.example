# Local-only secrets for `pnpm dev`. Never commit `.dev.vars`.
#
# In production these are set as Worker secrets — the `pnpm bootstrap`
# script handles this for you. Manual override:
#   pnpm --filter @sufra/web exec wrangler secret put <NAME>

# 32-byte random string used to sign session cookies.
# Generate with: openssl rand -base64 32
# NEVER ship a placeholder value — anyone who reads this repo can forge
# sessions if you do.
BETTER_AUTH_SECRET=""

# OPTIONAL. Set ONLY if you bind a custom domain to the Worker.
# When deploying to *.workers.dev, leave empty — the Worker uses the
# request origin and the cookie scopes correctly.
BETTER_AUTH_URL=""

# OpenRouter API key for vision analysis. Get one at:
#   https://openrouter.ai/keys
# They give $1 free credit on signup, which covers hundreds of meals.
OPENROUTER_API_KEY=""
