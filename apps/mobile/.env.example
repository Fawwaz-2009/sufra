# The Sufra Worker origin the native app talks to. Better Auth appends /api/auth; the typed client
# (slice 2) will hit /api/*. EXPO_PUBLIC_* is inlined into the JS bundle at build time.
#
# Dev: front `cd apps/web && pnpm dev` (Vite + workerd on :5173) with a cloudflared quick tunnel for a
# stable https origin (https sidesteps the Secure-cookie/origin questions cookie-replay is sensitive to):
#
#   cloudflared tunnel --url http://localhost:5173    →    https://<name>.trycloudflare.com
#
# Put that origin BOTH here and in apps/web/.dev.vars (BETTER_AUTH_URL=…) so the cookie origin matches.
# Copy this file to .env (gitignored) and fill in the tunnel URL.
EXPO_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
