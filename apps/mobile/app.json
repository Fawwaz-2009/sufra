{
  "expo": {
    "name": "Sufra",
    "slug": "sufra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sufra",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fawwaz2009.sufra",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Sufra connects to the development server on your local network.",
        "NSBonjourServices": [
          "_expo._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6E8D5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fawwaz2009.sufra"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sufra uses your photos so you can log a Meal from your library.",
          "cameraPermission": "Sufra uses your camera so you can log a Meal from a photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6E8D5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c492a4b0-b813-4c7e-8218-1ff58cc2af8f"
      }
    },
    "owner": "fawwaz-2009"
  }
}
