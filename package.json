{
  "name": "sufra",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "conventions:sync": "sh scripts/sync-conventions.sh",
    "postinstall": "sh scripts/sync-conventions.sh || true",
    "dev": "turbo run dev --filter=@sufra/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "deploy": "turbo run deploy --filter=@sufra/web",
    "deploy:staging": "pnpm --filter @sufra/web run deploy:staging",
    "cf-typegen": "pnpm --filter @sufra/web run cf-typegen",
    "db:generate": "pnpm --filter @sufra/web run db:generate",
    "db:migrate:local": "pnpm --filter @sufra/web run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @sufra/web run db:migrate:remote",
    "db:migrate:staging": "pnpm --filter @sufra/web run db:migrate:staging",
    "eval": "pnpm --filter @sufra/evals run eval",
    "eval:view": "pnpm --filter @sufra/evals run eval:view",
    "bootstrap": "node ./scripts/bootstrap.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.4.0",
    "jsonc-parser": "^3.3.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "better-sqlite3"
    ],
    "overrides": {
      "sharp": "^0.34.5",
      "kysely": "0.28.17"
    }
  }
}
