# Make `sharp` use its prebuilt platform package (@img/sharp-darwin-arm64 etc.)
# instead of detecting a homebrew-installed libvips and trying to build from
# source. Without this, sharp's install/check.js exits 1 on machines with
# system libvips, which triggers a source build that fails without node-addon-api.
SHARP_IGNORE_GLOBAL_LIBVIPS=1
