{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["**/*.tsbuildinfo"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "eval": {
      "cache": false
    },
    "eval:view": {
      "cache": false,
      "persistent": true
    }
  }
}
