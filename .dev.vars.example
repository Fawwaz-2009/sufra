# Local-only secrets for `pnpm dev`. Never commit `.dev.vars`.
# Generate the auth secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Base URL better-auth uses for callbacks + cookie scope. Without this,
# better-auth logs a warning on every request ("Base URL could not be
# determined"). Match the dev server's host:port (default 5173).
# In production, set via `wrangler secret put BETTER_AUTH_URL` to the
# deployed origin (e.g. https://sufra.example.com).
BETTER_AUTH_URL="http://localhost:5173"

# OpenRouter API key for vision analysis (worker/vision/openrouter.ts).
# Get one at https://openrouter.ai. In production, set via:
#   wrangler secret put OPENROUTER_API_KEY
OPENROUTER_API_KEY=""
